# Private artifact host

# Only needed when running outside Vercel. Create a PRIVATE Blob store and use
# its read-write token. On Vercel, the SDK uses VERCEL_OIDC_TOKEN + BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=

# Bearer token used by the opencode plugin / curl to publish.
# Generate with: openssl rand -base64 32
ARTIFACTS_PUBLISH_TOKEN=

# Shared passphrase humans type to unlock artifacts.
# Generate with: openssl rand -base64 24
ARTIFACTS_VIEW_PASSPHRASE=

# Secret used to sign the session cookie. Must be stable across deployments.
# Generate with: openssl rand -base64 48
ARTIFACTS_COOKIE_SECRET=

# Optional: public base URL, used for links returned by the publish API.
# Defaults to the request origin. Set this if you use a custom domain.
ARTIFACTS_PUBLIC_URL=

# Optional: session lifetime in hours (default 168 = 7 days).
ARTIFACTS_SESSION_TTL_HOURS=

# Optional local development backend: store artifacts on disk instead of Blob.
# Never set this in production.
# ARTIFACTS_LOCAL_DIR=.artifacts-local
